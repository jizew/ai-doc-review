# Example config template (no secrets)
llm:
  provider: openai
  model: gpt-4o
  api_key: ""
  base_url: ""
  temperature: 0.3
  max_tokens: 4096
  timeout: 300.0

llm_presets:
  - name: example-openai
    config:
      provider: openai
      model: gpt-4o
      api_key: ""
      base_url: ""
      temperature: 0.3
      max_tokens: 4096
      timeout: 300.0

proofreading:
  mode: comments
  chunk_mode: paragraph
  chunk_size: 500
  chunk_overlap: 50
  batch_size: 5
  max_retries: 5
  max_parse_retries: 3
  base_retry_delay: 2.0
  preserve_formatting: true
  reference_formatting: false
  ai_editor_name: AI Editor
  add_header: false
  cn_font: 宋体
  en_font: Times New Roman
  apply_font_global: true
  fallback_preset: 无 (不使用)

ui:
  title: AI 文档智能审校系统
  page_width: wide
  cache_ttl: 3600

test_mode:
  enabled: false
  chunks: 2

prompt:
  system: 你是一位专业的中文编辑，负责文档校对和润色。
  detail_level: standard
